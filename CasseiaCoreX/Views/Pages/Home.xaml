<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CasseiaCoreX.Pages.Home"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CasseiaCoreX.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <ScrollViewer>
        <Grid x:Name="RootGrid">


            <Viewbox Margin="80" MaxWidth="640">
                <Grid x:Name="WallpaperShow">
                    <Image x:Name="WallpaperIMG" Height="300" Width="480" Stretch="UniformToFill" Source="{x:Bind ViewModel.Wallpaper, Mode=OneWay}"/>
                    <Rectangle Stroke ="Black" Height="305" Width="490" StrokeThickness="10" RadiusX="8" RadiusY="8"/>
                </Grid>
            </Viewbox>


            <Grid Margin="40" x:Name="InfoShow">
                <StackPanel Orientation="Vertical" VerticalAlignment="Center">

                    
                    <!--显示 CPU 名称-->
                    <Button Background="Transparent" BorderBrush="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MaxWidth="1000" Height="80">
                        <Grid HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE950;"/>
                            <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center">
                                <TextBlock Text="处理器" FontWeight="Bold"/>
                                <TextBlock x:Name="CPUNameShow" Text="{x:Bind ViewModel.CPUName, Mode=OneWay}"/>
                            </StackPanel>
                        </Grid>
                    </Button>
                    <!--显示 RAM 大小-->
                    <Button Background="Transparent" BorderBrush="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MaxWidth="1000" Height="80">
                        <Grid HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE964;"/>
                            <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center">
                                <TextBlock Text="内存" FontWeight="Bold"/>
                                <TextBlock x:Name="RAMNameShow" Text="{x:Bind ViewModel.RAMInfo, Mode=OneWay}"/>
                            </StackPanel>
                        </Grid>
                    </Button>
                    <!--跳转 GPU 列表-->
                    <Button Command="{Binding ShowGpuListCommand}" Background="Transparent" BorderBrush="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MaxWidth="1000" Height="80">
                        <Grid HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xF211;"/>
                            <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center">
                                <TextBlock Text="显示适配器" FontWeight="Bold"/>
                                <TextBlock x:Name="GPUNameShow" Text="{x:Bind ViewModel.GPUName, Mode=OneWay}"/>
                            </StackPanel>
                        </Grid>
                    </Button>
                    <!--显示 Windows 版本-->
                    <Button Background="Transparent" BorderBrush="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MaxWidth="1000" Height="80">
                        <Grid HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8FC;"/>
                            <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center">
                                <TextBlock x:Name="OSBrandName" Text="{x:Bind ViewModel.WindowsBrandName, Mode=OneWay}" FontWeight="Bold"/>
                                <TextBlock x:Name="OSVersionShow" Text="{x:Bind ViewModel.WindowsVersion, Mode=OneWay}"/>
                            </StackPanel>
                        </Grid>
                    </Button>
                    <!--显示 CasseiaOS 版本-->
                    <Button Background="Transparent" BorderBrush="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MaxWidth="1000" Height="80" Visibility="{x:Bind ViewModel.IsShowCasseiaOSVer, Mode=OneWay}">
                        <Grid HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xF0E2;"/>
                            <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center">
                                <TextBlock Text="CasseiaOS 版本" FontWeight="Bold"/>
                                <TextBlock x:Name="CasseiaOSVerShow" Text="{x:Bind ViewModel.CasseiaOSVer, Mode=OneWay}"/>
                            </StackPanel>
                        </Grid>
                    </Button>
                    <!--显示 CasseiaCore 版本-->
                    <Button Background="Transparent" BorderBrush="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MaxWidth="1000" Height="80">
                        <Grid HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xEA3A;"/>
                            <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center">
                                <TextBlock Text="CasseiaCore 版本" FontWeight="Bold"/>
                                <TextBlock x:Name="LibVersionShow" Text="{x:Bind ViewModel.LibVersion, Mode=OneWay}"/>
                            </StackPanel>
                        </Grid>
                    </Button>
                    <!--显示主板信息-->
                    <Button Background="Transparent" BorderBrush="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MaxWidth="1000" Height="80">
                        <Grid HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xF404;"/>
                            <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center">
                                <TextBlock Text="主板型号" FontWeight="Bold"/>
                                <TextBlock x:Name="BaseBoardInfoShow" Text="{x:Bind ViewModel.BaseBoardInfo, Mode=OneWay}"/>
                            </StackPanel>
                        </Grid>
                    </Button>
                    <!--显示当前屏幕信息-->
                    <Button Background="Transparent" BorderBrush="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MaxWidth="1000" Height="80">
                        <Grid HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE770;"/>
                            <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center">
                                <TextBlock Text="当前屏幕信息" FontWeight="Bold"/>
                                <TextBlock x:Name="DisplayShow" Text="{x:Bind ViewModel.DisplayInfoText, Mode=OneWay}"/>
                            </StackPanel>
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>