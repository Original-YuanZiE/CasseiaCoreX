<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CasseiaCoreX.Pages.SysSettings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CasseiaCoreX.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <ScrollViewer>
        <Grid Margin="40">
            <StackPanel Orientation="Vertical" Spacing="10" MaxWidth="1000">

                <TextBlock Text="系统设置" FontSize="26" FontWeight="Bold" Margin="0,48,0,38" TextWrapping="Wrap"/>

                <TextBlock Text="文件资源管理器" FontSize="14" Margin="0,0,0,10" TextWrapping="Wrap"/>

                <!--快捷方式角标隐藏-->
                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MaxWidth="1000" MinHeight="80">
                    <Grid HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xEE49;"/>
                        <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center">
                            <TextBlock Text="隐藏快捷方式箭头角标" FontWeight="Bold" TextWrapping="Wrap"/>
                            <TextBlock Text="隐藏快捷方式左下角的小箭头角标，重启资源管理器可生效" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="2" x:Name="ShortcutArrowSwitch" OnContent="" OffContent="" IsOn="{x:Bind ViewModel.IsShortcutArrowHidden, Mode=TwoWay}"/>
                    </Grid>
                </Button>
                <!--解锁平板任务栏-->
                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MaxWidth="1000" MinHeight="80" Command="{x:Bind ViewModel.UnLockTabletModeCommand, Mode=OneWay}">
                    <Grid HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE70A;"/>
                        <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center">
                            <TextBlock Text="[危险]解锁平板任务栏" FontWeight="Bold" TextWrapping="Wrap"/>
                            <TextBlock Text="适合支持触控操作的 Windows 平板使用，可能导致严重 BUG，慎用！" TextWrapping="Wrap"/>
                        </StackPanel>
                        <FontIcon Grid.Column="2" FontFamily="Segoe Fluent Icons" Glyph="&#xE724;"/>
                    </Grid>
                </Button>
                <!--任务栏显秒-->
                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MaxWidth="1000" MinHeight="80">
                    <Grid HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xEC92;"/>
                        <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center">
                            <TextBlock Text="任务栏时钟精确到秒" FontWeight="Bold" TextWrapping="Wrap"/>
                            <TextBlock Text="不确保在所有系统版本有效" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="2" x:Name="TaskBarSecSwitch" OnContent="" OffContent="" IsOn="{x:Bind ViewModel.IsTaskBarShowSec, Mode=TwoWay}"/>
                    </Grid>
                </Button>
                <!--重启Explorer-->
                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MaxWidth="1000" MinHeight="80" Command="{x:Bind ViewModel.RestartExplorer, Mode=OneWay}">
                    <Grid HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8B7;"/>
                        <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center">
                            <TextBlock Text="重启文件资源管理器" FontWeight="Bold" TextWrapping="Wrap"/>
                            <TextBlock Text="点此快速重启 explorer.exe" TextWrapping="Wrap"/>
                        </StackPanel>
                        <FontIcon Grid.Column="2" FontFamily="Segoe Fluent Icons" Glyph="&#xE724;"/>
                    </Grid>
                </Button>

                <TextBlock Text="系统" FontSize="14" Margin="0,10,0,10" TextWrapping="Wrap"/>

                <!--CMD 自动执行-->
                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MaxWidth="1000" MinHeight="80" Command="{x:Bind ViewModel.CMDAutoRunCommand, Mode=OneWay}">
                    <Grid HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE756;"/>
                        <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center">
                            <TextBlock Text="命令提示符自动执行" FontWeight="Bold" TextWrapping="Wrap"/>
                            <TextBlock Text="当命令提示符会话启动时自动执行命令，点击此处设置" TextWrapping="Wrap"/>
                        </StackPanel>
                        <FontIcon Grid.Column="2" FontFamily="Segoe Fluent Icons" Glyph="&#xE724;"/>
                    </Grid>
                </Button>
                <!--长路径支持-->
                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MaxWidth="1000" MinHeight="80">
                    <Grid HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE838;"/>
                        <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center">
                            <TextBlock Text="启用长路径支持" FontWeight="Bold" TextWrapping="Wrap"/>
                            <TextBlock Text="顾名思义" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="2" x:Name="LongPathSwitch" OnContent="" OffContent="" IsOn="{x:Bind ViewModel.LongPathSupport, Mode=TwoWay}"/>
                    </Grid>
                </Button>
                <!--LogonUI 显示详细信息-->
                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MaxWidth="1000" MinHeight="80">
                    <Grid HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7BC;"/>
                        <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center">
                            <TextBlock Text="启用 LogonUI 详细信息" FontWeight="Bold" TextWrapping="Wrap"/>
                            <TextBlock Text="在关机、注销和登录等界面显示详细信息，此更改需要重启计算机才能生效" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="2" x:Name="VerboseSwitch" OnContent="" OffContent="" IsOn="{x:Bind ViewModel.LogonUIInfo, Mode=TwoWay}"/>
                    </Grid>
                </Button>
                <!--UAC 设置-->
                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MaxWidth="1000" MinHeight="80" Command="{x:Bind ViewModel.UACSettingsCommand, Mode=OneWay}">
                    <Grid HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7EF;"/>
                        <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center">
                            <TextBlock Text="调整用户账户控制设置" FontWeight="Bold" TextWrapping="Wrap"/>
                            <TextBlock Text="顾名思义" TextWrapping="Wrap"/>
                        </StackPanel>
                        <FontIcon Grid.Column="2" FontFamily="Segoe Fluent Icons" Glyph="&#xE724;"/>
                    </Grid>
                </Button>
                <!--禁用 Defender-->
                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MaxWidth="1000" MinHeight="80">
                    <Grid HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE83D;"/>
                        <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center">
                            <TextBlock Text="禁用 Defender" FontWeight="Bold" TextWrapping="Wrap"/>
                            <TextBlock Text="无法彻底禁用它，只能禁用部分功能，如实时保护；无法保证在所有系统生效" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="2" x:Name="DefenderSwitch" OnContent="" OffContent="" IsOn="{x:Bind ViewModel.DisableDefender, Mode=TwoWay}"/>
                    </Grid>
                </Button>
                <!--强制启用云母与圆角-->
                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MaxWidth="1000" MinHeight="80">
                    <Grid HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE727;"/>
                        <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center">
                            <TextBlock Text="强制启用云母与圆角" FontWeight="Bold" TextWrapping="Wrap"/>
                            <TextBlock Text="可在无 GPU 驱动时启用高级材质，此更改需要重启计算机才能生效；需要 22H2 以上系统版本" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="2" x:Name="MicaSwitch" OnContent="" OffContent="" IsOn="{x:Bind ViewModel.ForceEffectMode, Mode=TwoWay}"/>
                    </Grid>
                </Button>
                <!--设置 OEM 信息-->
                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MaxWidth="1000" MinHeight="80" Command="{x:Bind ViewModel.SetOEMInfoCommand, Mode=OneWay}">
                    <Grid HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8A1;"/>
                        <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center">
                            <TextBlock Text="设置 OEM 信息" FontWeight="Bold" TextWrapping="Wrap"/>
                            <TextBlock Text="设置 OEM 信息，如制造商、型号与支持电话等" TextWrapping="Wrap"/>
                        </StackPanel>
                        <FontIcon Grid.Column="2" FontFamily="Segoe Fluent Icons" Glyph="&#xE724;"/>
                    </Grid>
                </Button>

                <TextBlock Text="Windows 更新" FontSize="14" Margin="0,10,0,10" TextWrapping="Wrap"/>

                <!--禁用 WindowsUpdate-->
                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MaxWidth="1000" MinHeight="80">
                    <Grid HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8D8;"/>
                        <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center">
                            <TextBlock Text="禁用 Windows 更新" FontWeight="Bold" TextWrapping="Wrap"/>
                            <TextBlock Text="通过修改更新服务器地址为 Localhost 来屏蔽更新，无副作用，重启电脑生效" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="2" x:Name="WUSwitch" OnContent="" OffContent="" IsOn="{x:Bind ViewModel.DisableUpdate, Mode=TwoWay}"/>
                    </Grid>
                </Button>
                <!--设置最大暂停更新时间-->
                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MaxWidth="1000" MinHeight="80" Command="{x:Bind ViewModel.MaxDelayUpdateTimeCommand, Mode=OneWay}">
                    <Grid HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xECC5;"/>
                        <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center">
                            <TextBlock Text="设置最大暂停更新天数" FontWeight="Bold" TextWrapping="Wrap"/>
                            <TextBlock Text="可以改成很大的数值，再在系统设置中选择最大的暂停周数以屏蔽更新" TextWrapping="Wrap"/>
                        </StackPanel>
                        <FontIcon Grid.Column="2" FontFamily="Segoe Fluent Icons" Glyph="&#xE724;"/>
                    </Grid>
                </Button>

                <TextBlock Text="Windows 激活" FontSize="14" Margin="0,10,0,10" TextWrapping="Wrap"/>

                <!--清除激活密钥-->
                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MaxWidth="1000" MinHeight="80" Command="{x:Bind ViewModel.ClearKeysCommand, Mode=OneWay}">
                    <Grid HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8D7;"/>
                        <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center">
                            <TextBlock Text="[危险]清除已安装的密钥" FontWeight="Bold" TextWrapping="Wrap"/>
                            <TextBlock Text="顾名思义，但无法取消数字激活" TextWrapping="Wrap"/>
                        </StackPanel>
                        <FontIcon Grid.Column="2" FontFamily="Segoe Fluent Icons" Glyph="&#xE724;"/>
                    </Grid>
                </Button>
                <!--数字激活-->
                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MaxWidth="1000" MinHeight="80" Command="{x:Bind ViewModel.HWIDCommand, Mode=OneWay}">
                    <Grid HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8D7;"/>
                        <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center">
                            <TextBlock Text="数字激活 (Beta)" FontWeight="Bold" TextWrapping="Wrap"/>
                            <TextBlock Text="使用 HWID 激活 Windows，部分版本无法使用此功能激活" TextWrapping="Wrap"/>
                        </StackPanel>
                        <FontIcon Grid.Column="2" FontFamily="Segoe Fluent Icons" Glyph="&#xE724;"/>
                    </Grid>
                </Button>
                <!--Home转Pro-->
                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MaxWidth="1000" MinHeight="80" Command="{x:Bind ViewModel.Home2ProCommand, Mode=OneWay}">
                    <Grid HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8D7;"/>
                        <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center">
                            <TextBlock Text="[危险]家庭版转专业版" FontWeight="Bold" TextWrapping="Wrap"/>
                            <TextBlock Text="一旦成功无法轻易还原为家庭版" TextWrapping="Wrap"/>
                        </StackPanel>
                        <FontIcon Grid.Column="2" FontFamily="Segoe Fluent Icons" Glyph="&#xE724;"/>
                    </Grid>
                </Button>
                <!--备份密钥-->
                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MaxWidth="1000" MinHeight="80" Command="{x:Bind ViewModel.BackupKeysCommand}">
                    <Grid HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8D7;"/>
                        <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center">
                            <TextBlock Text="备份此电脑上的许可证" FontWeight="Bold" TextWrapping="Wrap"/>
                            <TextBlock Text="支持零售密钥，OEM 与 HWID 密钥支持性未知" TextWrapping="Wrap"/>
                        </StackPanel>
                        <FontIcon Grid.Column="2" FontFamily="Segoe Fluent Icons" Glyph="&#xE724;"/>
                    </Grid>
                </Button>

            </StackPanel>
            
        </Grid>
    </ScrollViewer>
</Page>